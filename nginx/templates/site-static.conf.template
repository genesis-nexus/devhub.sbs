# Nginx Site Configuration Template - Static Website
# Template variables (replace when deploying):
#   {{SITE_NAME}}     - Site identifier (e.g., devhub, mysite)
#   {{DOMAIN}}        - Primary domain (e.g., devhub.sbs, example.com)
#   {{DOMAIN_ALIASES}} - Additional domains/subdomains (space-separated, optional)
#   {{DOC_ROOT}}      - Document root path (e.g., /var/www/devhub.sbs/docs)
#
# Place generated config at: /etc/nginx/sites-available/{{SITE_NAME}}.conf

server {
    listen 80;
    listen [::]:80;

    # Domain configuration
    server_name {{DOMAIN}} {{DOMAIN_ALIASES}};

    # Document root
    root {{DOC_ROOT}};
    index index.html index.htm;

    # Logging (per-site logs)
    access_log /var/log/nginx/{{SITE_NAME}}-access.log;
    error_log /var/log/nginx/{{SITE_NAME}}-error.log;

    # Main location block - serve static files
    location / {
        # Try to serve file, then directory, then fall back to index.html (SPA support)
        try_files $uri $uri/ /index.html;
    }

    # Security: Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Cache static assets
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|webp|avif|mp4|webm|pdf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Special files
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /sitemap.xml {
        log_not_found off;
        access_log off;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
