# Nginx Site Configuration Template - Static Website with SSL
# Template variables (replace when deploying):
#   {{SITE_NAME}}      - Site identifier (e.g., devhub, mysite)
#   {{DOMAIN}}         - Primary domain (e.g., devhub.sbs, example.com)
#   {{DOMAIN_ALIASES}} - Additional domains/subdomains (space-separated, optional)
#   {{DOC_ROOT}}       - Document root path (e.g., /var/www/devhub.sbs/docs)
#
# Prerequisites: SSL certificate must exist at /etc/letsencrypt/live/{{DOMAIN}}/
# Run: sudo certbot certonly --nginx -d {{DOMAIN}}
#
# Place generated config at: /etc/nginx/sites-available/{{SITE_NAME}}.conf

# HTTP - Redirect all traffic to HTTPS
server {
    listen 80;
    listen [::]:80;

    server_name {{DOMAIN}} {{DOMAIN_ALIASES}};

    # Allow Let's Encrypt verification
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all other requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS - Main server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name {{DOMAIN}} {{DOMAIN_ALIASES}};

    # SSL Certificate (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;

    # SSL Settings (modern configuration)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/{{DOMAIN}}/chain.pem;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # Document root
    root {{DOC_ROOT}};
    index index.html index.htm;

    # Logging (per-site logs)
    access_log /var/log/nginx/{{SITE_NAME}}-access.log;
    error_log /var/log/nginx/{{SITE_NAME}}-error.log;

    # Main location block - serve static files
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security: Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Cache static assets
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|webp|avif|mp4|webm|pdf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Special files
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /sitemap.xml {
        log_not_found off;
        access_log off;
    }

    # Security headers (enhanced for HTTPS)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
