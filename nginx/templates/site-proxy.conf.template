# Nginx Site Configuration Template - Reverse Proxy
# Template variables (replace when deploying):
#   {{SITE_NAME}}      - Site identifier (e.g., api, app)
#   {{DOMAIN}}         - Primary domain (e.g., api.devhub.sbs)
#   {{DOMAIN_ALIASES}} - Additional domains/subdomains (space-separated, optional)
#   {{UPSTREAM_HOST}}  - Backend server address (e.g., 127.0.0.1)
#   {{UPSTREAM_PORT}}  - Backend server port (e.g., 3000, 8080)
#
# Place generated config at: /etc/nginx/sites-available/{{SITE_NAME}}.conf

# Upstream definition for load balancing / keepalive
upstream {{SITE_NAME}}_backend {
    server {{UPSTREAM_HOST}}:{{UPSTREAM_PORT}};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;

    # Domain configuration
    server_name {{DOMAIN}} {{DOMAIN_ALIASES}};

    # Logging (per-site logs)
    access_log /var/log/nginx/{{SITE_NAME}}-access.log proxy;
    error_log /var/log/nginx/{{SITE_NAME}}-error.log;

    # Increase client body size for file uploads (adjust as needed)
    client_max_body_size 10M;

    # Main location block - proxy all requests
    location / {
        proxy_pass http://{{SITE_NAME}}_backend;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Pass original host and client info
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # Health check endpoint (optional - adjust path as needed)
    location = /health {
        proxy_pass http://{{SITE_NAME}}_backend/health;
        access_log off;
    }

    # Security: Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
